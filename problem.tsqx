~triangle A B C
O = circumcenter A B C

# 辅助点（不显示）
P := (rotate 90 A)(O)       # 切线方向：把 O 绕 A 旋转 90°
Q := (rotate 90 C)(B)       # 垂线方向：把 B 绕 C 旋转 90°

K = extension A P C Q        # K = 切线 ∩ 垂线

R := (shift (minus B A))(K)  # KD // AB 的辅助点
D ;= extension K R B C       # D = 平行线 ∩ BC

circumcircle A B C
A--B--C--cycle
A--K
C--K
K--D / dashed bluepython -m tsqx -p problem.tsqx > problem.asypython -m tsqx -p problem.tsqx > problem.asypython -m tsqx -p problem.tsqx > problem.asypython -m tsqx -p problem.tsqx > problem.asy